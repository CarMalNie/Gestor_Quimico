# Local development settings. Copy to .env and fill in real values.
SECRET_KEY=your-secret-key-here
DEBUG=True
DB_NAME=gestor_quimico_bd
DB_USER=root
DB_PASSWORD=your-db-password-here
DB_HOST=localhost
DB_PORT=3306
# Extra hosts separated by commas (production domain, etc.)
ALLOWED_HOSTS=127.0.0.1,localhost

# HTTPS hardening (set to true/seconds only behind HTTPS in production).
SECURE_HSTS_SECONDS=0
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Login rate limiting (django-axes). Disable only for local test runs.
AXES_ENABLED=True

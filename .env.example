# Local development settings. Copy to .env and fill in real values.
SECRET_KEY=your-secret-key-here
DEBUG=True
DB_NAME=gestor_quimico_bd
DB_USER=root
DB_PASSWORD=your-db-password-here
DB_HOST=localhost
DB_PORT=3306
# Extra hosts separated by commas (production domain, etc.)
ALLOWED_HOSTS=127.0.0.1,localhost

# HTTPS hardening (set to true/seconds only behind HTTPS in production).
SECURE_HSTS_SECONDS=0
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Login rate limiting (django-axes). Disable only for local test runs.
AXES_ENABLED=True

# Email (password recovery). Leave EMAIL_HOST empty in development: the console
# backend prints the reset email in the terminal instead of sending it.
# Defining EMAIL_HOST switches the backend to SMTP automatically.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Gestor Quimico <no-reply@gestorquimico.local>

# SMTP example A - Gmail with an app password (requires 2FA enabled;
# roughly 500 messages/day). Generate the app password in the Google account.
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=True
#   EMAIL_HOST_USER=your-account@gmail.com
#   EMAIL_HOST_PASSWORD=the-16-character-app-password
#
# SMTP example B - Brevo SMTP relay (free tier, roughly 300 messages/day).
#   EMAIL_HOST=smtp-relay.brevo.com
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=True
#   EMAIL_HOST_USER=your-brevo-login@example.com
#   EMAIL_HOST_PASSWORD=your-brevo-smtp-key
#
# Never put real credentials here: this file is committed, .env is not.
